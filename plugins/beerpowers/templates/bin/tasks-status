#!/bin/sh
# generated by beerpowers v{{BEERPOWERS_VERSION}} — не править: обновляет /beerpowers:update
# Статус артефактов в memory/tasks/: по каждой папке — где задача жила и влита ли она.
#
# Решение об удалении скрипт НЕ принимает: он собирает факты, вывод читает тот, кто убирает.
# Запуск: .claude/bin/tasks-status [--fetch] [--remote]
#   --fetch   обновить origin во всех репозиториях workspace перед замером (нужна сеть)
#   --remote  дополнительно спросить сервер, существует ли ещё ветка задачи (нужна сеть)
#
# Репозитории — по правилу обхода projects/, папки задач — memory/tasks/; строки вывода
# называют репозиторий путём от корня workspace.
# Цели сравнения по репозиторию — ветка по умолчанию на сервере и база задачи из
# memory/tasks/<КОД>/git-flow.md (релизная, ветка предшественника), если она там названа;
# считает их lib/git.mjs. Корень — каталог над .claude/, переменная окружения
# WORKSPACE_ROOT его переопределяет (проверка на одноразовой фикстуре).
#
# Две вещи, на которых скрипт врёт правдоподобно и которые нельзя возвращать:
#
# 1. Цели сравнения — только `origin/*`. Локальная ветка по умолчанию отстаёт молча,
#    и влитые задачи выглядят активными.
# 2. Влитость считает lib/git.mjs merged — по предкам коммита или по patch-id, а не
#    `rev-list --count` по хешам: при слиянии ребейзом или cherry-pick'ом влитая работа
#    лежит наверху под другими хешами, и счётчик по хешам называет её неслитой всегда.

case "${1:-}" in
  -h|--help) awk 'NR > 2 && !/^#/ { exit } NR > 2 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
esac

self_dir=$(cd -- "$(dirname -- "$0")" && pwd)
. "$self_dir/lib/workspace.sh"
ws_load || exit 1

ROOT=$(ws_root)
TASKS_REL=$(ws_get tasksDir)
TASKS="$ROOT/$TASKS_REL"
GITLIB="$self_dir/lib/git.mjs"
tab=$(printf '\t')
CHECK_REMOTE=0
DO_FETCH=0
for arg in "$@"; do
  [ "$arg" = "--remote" ] && CHECK_REMOTE=1
  [ "$arg" = "--fetch" ] && DO_FETCH=1
done

[ -d "$TASKS" ] || { echo "$TASKS_REL/ нет — чистить нечего"; exit 0; }

# Пути репозиториев режутся по пробелам ниже, поэтому имя вне [A-Za-z0-9_.-] пропускается
# с предупреждением, а не ломает разбор молча.
REPOS=""
NAMES=""
REPOS_LIST=$(ws_repos)
while IFS="$tab" read -r name rpath; do
  [ -n "$name" ] || continue
  case "$name" in
    *[!A-Za-z0-9_.-]*) echo "⚠ $rpath: имя «$name» вне [A-Za-z0-9_.-] — пропускаю"; continue ;;
  esac
  REPOS="$REPOS $rpath"
  NAMES="$NAMES $name=$rpath"
done <<EOF
$REPOS_LIST
EOF
[ -n "$REPOS" ] || echo "⚠ в workspace нет ни одного репозитория — следов задач искать негде"

name_of() {
  for pair in $NAMES; do
    [ "${pair#*=}" = "$1" ] && { printf '%s\n' "${pair%%=*}"; return; }
  done
}

if [ "$DO_FETCH" = "1" ]; then
  for repo in $REPOS; do
    git -C "$ROOT/$repo" rev-parse --git-dir >/dev/null 2>&1 || continue
    git -C "$ROOT/$repo" fetch origin --prune --quiet 2>/dev/null
  done
  echo "origin обновлён во всех доступных репозиториях"
else
  # Давность последнего fetch: без неё читающий не знает, насколько свежи цели сравнения.
  stale=""
  for repo in $REPOS; do
    head="$ROOT/$repo/.git/FETCH_HEAD"
    [ -f "$head" ] || continue
    if [ -z "$(find "$head" -newermt '1 day ago' 2>/dev/null)" ]; then
      stale="$stale $repo"
    fi
  done
  [ -n "$stale" ] && echo "⚠ origin не обновлялся больше суток:$stale — перезапусти с --fetch"
fi

# Ветка по умолчанию каждого репозитория — один запрос к серверу на весь прогон.
DEFAULTS=""
for repo in $REPOS; do
  b=$(node "$GITLIB" defaults "$ROOT" "$(name_of "$repo")" 2>/dev/null | awk -F '\t' '$1 == "base" { print $2 }')
  [ -n "$b" ] && DEFAULTS="$DEFAULTS $repo=$b"
  [ -n "$b" ] || echo "⚠ $repo: ветку по умолчанию не узнать — профиль custom или сервер не ответил; цель — только база из git-flow.md задачи"
done
default_of() {
  for pair in $DEFAULTS; do
    [ "${pair%%=*}" = "$1" ] && { printf '%s\n' "${pair#*=}"; return; }
  done
}

for dir in "$TASKS"/*/; do
  [ -d "$dir" ] || continue

  code=$(basename "$dir")

  # Считаем всё дерево папки, а не только корень: выгрузка постановки живёт
  # в tracker/task.md и tracker/task-attachment/*, и при -maxdepth 1 свежая задача
  # выглядела бы как «файлов: 0» — то есть кандидатом в «брошенные».
  files=$(find "$dir" -type f | wc -l)
  changed=$(find "$dir" -type f -newermt '30 days ago' | wc -l)

  echo "=== $code"
  echo "  файлов: $files, изменялись за последние 30 дней: $changed"

  # Имя папки не всегда совпадает с тем, что писали в коммитах. У задачи из трекера
  # совпадает (<КОД> → «fix(<КОД>): …»), а у работы без трекера нет: папка
  # fix-header-scroll-favorites, а коммиты — «fix(favorites-ssr): …» и «fix(header-scroll): …».
  # Поиск строго по имени давал бы «следов не найдено» на полностью влитой работе.
  # Поэтому для некодовых имён шаблон собирается из слов имени длиннее трёх символов,
  # а вывод помечается как нестрогий.
  case "$code" in
    [A-Z]*-[0-9]*)
      pattern="$code"
      loose=0
      ;;
    *)
      # Дефис в наборе tr идёт последним: с первой позиции он читается как начало опции.
      pattern=$(printf '%s' "$code" | tr '_/-' '\n\n\n' | awk 'length($0) > 3' | paste -sd '|' -)
      [ -z "$pattern" ] && pattern="$code"
      loose=1
      echo "  имя не код трекера — поиск нестрогий, по шаблону: $pattern"
      ;;
  esac

  found_anywhere=0
  overrides=$(node "$GITLIB" task "$ROOT" "$code" 2>/dev/null)

  for repo in $REPOS; do
    path="$ROOT/$repo"
    # Спрашиваем git, а не ищем каталог `.git`: в worktree это файл со строкой `gitdir:`,
    # и проверка `-d` молча пропускала бы такой репозиторий, а задача получала бы вердикт
    # «следов не найдено» — то есть «брошена».
    git -C "$path" rev-parse --git-dir >/dev/null 2>&1 || continue

    default=$(default_of "$repo")
    task_base=$(printf '%s\n' "$overrides" | awk -F '\t' -v r="$(name_of "$repo")" '$1 == r && $2 != "-" { print $2 }')
    in_default=0
    [ -n "$default" ] && in_default=$(git -C "$path" log "origin/$default" -E --grep="$pattern" --oneline 2>/dev/null | wc -l)
    branch=$(git -C "$path" branch --list "$code" 2>/dev/null | wc -l)

    # У некодовой задачи ветка тоже называется иначе, чем папка: fix/header-scroll
    # против fix-header-scroll-favorites. Ищем по тем же словам.
    if [ "$loose" = "1" ] && [ "$branch" = "0" ]; then
      branch=$(git -C "$path" for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null | grep -cE "$pattern" || true)
    fi

    # База задачи не по умолчанию (релизная, ветка предшественника): работа сначала попадает
    # туда и только потом — в ветку по умолчанию. Считать задачу незавершённой по одной ветке
    # по умолчанию нельзя — её артефакты выглядели бы вечно активными.
    in_base=""
    if [ -n "$task_base" ] && git -C "$path" rev-parse --verify --quiet "origin/$task_base" >/dev/null 2>&1; then
      n=$(git -C "$path" log "origin/$task_base" -E --grep="$pattern" --oneline 2>/dev/null | wc -l)
      [ "$n" -gt 0 ] && in_base="origin/$task_base($n)"
    fi

    # Влита ли локальная ветка хотя бы в одну цель — lib/git.mjs: по предкам или по патчу.
    unmerged=""
    if [ "$branch" -gt 0 ] && [ "$loose" = "0" ]; then
      targets=""
      for t in "$default" "$task_base"; do
        [ -n "$t" ] && git -C "$path" rev-parse --verify --quiet "origin/$t" >/dev/null 2>&1 && targets="$targets origin/$t"
      done
      if [ -z "$targets" ]; then
        unmerged=", локальная ветка есть, целей для сравнения нет"
      else
        # shellcheck disable=SC2086
        verdict=$(node "$GITLIB" merged "$ROOT" "$(name_of "$repo")" "$code" $targets 2>/dev/null)
        hit=$(printf '%s\n' "$verdict" | awk -F '\t' '$2 == "влита" { print $1; exit }')
        if [ -n "$hit" ]; then
          unmerged=", локальная ветка есть, влита в $hit — работа отдана"
        else
          unmerged=", локальная ветка есть, не влита: $(printf '%s\n' "$verdict" | awk -F '\t' '{ printf "%s%s — %s", sep, $1, $3; sep = "; " }')"
        fi
      fi
    elif [ "$branch" -gt 0 ]; then
      unmerged=", похожая локальная ветка есть — имя не код задачи, влитость не проверяю"
    fi

    remote=""
    if [ "$CHECK_REMOTE" = "1" ]; then
      if git -C "$path" ls-remote --heads origin "$code" 2>/dev/null | grep -q "$code"; then
        remote=", ветка на сервере есть"
      else
        remote=", ветки на сервере нет"
      fi
    fi

    if [ "$in_default" -gt 0 ] || [ "$branch" -gt 0 ] || [ -n "$in_base" ]; then
      found_anywhere=1
      state="в origin/${default:-?}: $in_default коммит(ов)"
      [ -n "$in_base" ] && state="$state, в базе задачи: $in_base"
      state="$state$unmerged"
      echo "  $repo — $state$remote"
    fi
  done

  if [ "$found_anywhere" = "0" ]; then
    echo "  следов задачи в репозиториях не найдено"
  fi
done
