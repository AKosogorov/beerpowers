#!/usr/bin/env bash
# generated by beerpowers v{{BEERPOWERS_VERSION}} — не править: обновляет /beerpowers:update
#
# worktree-add — завести worktree задачи и положить в него файлы окружения.
#
#     .claude/bin/worktree-add <имя-репо> <КОД>
#     .claude/bin/worktree-add projects/<имя-репо> <КОД> origin/<релизная-ветка> --copy-env
#     .claude/bin/worktree-add <имя-репо> <КОД> --no-deps   # без установки зависимостей
#     .claude/bin/worktree-add <имя-репо> <КОД> -- <флаги>  # всё после -- уходит в worktree-setup
#
# Первый аргумент — репозиторий: projects/<имя-репо> или голое <имя-репо>. Второй — код задачи (он же имя ветки и имя каталога),
# третий необязательный — база ветки; без него база задачи по node .claude/bin/git-base.mjs:
# строка репозитория в memory/tasks/<КОД>/git-flow.md или профиль репозитория.
#
# Корень workspace — каталог над .claude/. Переменная окружения WORKSPACE_ROOT его
# переопределяет: так скрипт проверяют на одноразовой фикстуре.
#
# ФАЙЛЫ ОКРУЖЕНИЯ НЕ КОПИРУЮТСЯ БЕЗ ФЛАГА --copy-env. В .env лежат ключи, и они бывают
# боевыми: доступ к хранилищам, почте и базе, адреса API. Решение «эту копию делать можно»
# принимает человек, посмотрев в файл, а не скрипт. Без флага скрипт лишь скажет, что файл
# есть, и напомнит про флаг.
#
# Согласие часто приходит после того, как worktree уже заведён. Тогда тот же вызов
# с --copy-env на существующий каталог worktree докладывает только файлы окружения:
# ветку и проектную подготовку не трогает, уже лежащие в worktree файлы не перезаписывает.
# Отдельного пути через cp нет намеренно — у team-lead он закрыт разрешениями, а флаг
# скрипта оставляет след согласия в самом вызове.
#
# Каталог получается вида worktrees/<КОД-ЗАДАЧИ>/<имя-репозитория> — с сохранением
# имени репозитория. Это критично: правила из .claude/rules/ матчатся масками по имени
# репозитория (worktrees/*/<имя-репо>/**), и каталог с другим именем перестанет
# их подмешивать молча.
#
# Зачем это вообще нужно. Файл окружения под gitignore, поэтому в новый рабочий каталог
# он не приезжает, а инструменты, которые поднимают приложение (статанализ, тесты), падают
# на пустых переменных — и ошибки выглядят как долг кода.
#
# От ветки .env не зависит — в основном каталоге он тоже один на все ветки, так что копия
# не устареет от смены базы. Опасность в другом: в содержимом. Поэтому флаг.
#
# Содержимое .env скрипт НЕ читает — ни значений, ни имён переменных, только копирует файл
# целиком. Сверки ключей с .env.example нет намеренно: она требовала бы открыть секретный
# файл ради удобства. Следствие: если задача завела новую переменную, скопированный .env
# её не содержит и это всплывёт при запуске, а не заранее.
#
# ЗАВИСИМОСТИ СТАВЯТСЯ САМИ, по lock-файлу в корне репозитория: pnpm-lock.yaml — pnpm install
# --frozen-lockfile, package-lock.json — npm ci, composer.lock — composer install. Каталог
# зависимостей не делится между worktree'ями, а без него не работает ни сборка, ни статанализ,
# ни тесты — и падение выглядит как долг кода. Ставятся, а не копируются: каталоги привязаны
# к lock-файлам, ветка задачи может их поменять, и копия оказалась бы от другого набора версий.
# Инструмента нет в PATH — сказать и идти дальше; установка упала — отказ, worktree остаётся.
# --no-deps — пропустить, когда worktree нужен только читать код. Установка идёт после
# копирования окружения: postinstall-скрипты бывают зависимы от .env.
#
# Остальное, что зависит от проекта, — своя тестовая база, порт dev-сервера, — делает
# проектный хук: если есть исполняемый .claude/bin/worktree-setup, скрипт зовёт его после
# установки зависимостей с аргументами <КОД> <имя-репо> <абсолютный путь worktree>, а за ними —
# всё, что стоит после `--` в вызове worktree-add, и WORKSPACE_ROOT в окружении. Ненулевой
# код хука — ненулевой код скрипта, worktree при этом остаётся.

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
. "$self_dir/lib/workspace.sh"

usage() {
    awk 'NR > 3 && !/^#/ { exit } NR > 3 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

case "${1:-}" in
    -h|--help|'') usage; exit 0 ;;
esac

copy_env=0
deps=1
args=()
setup_args=()
passthrough=0
for arg in "$@"; do
    if [[ $passthrough -eq 1 ]]; then
        setup_args+=("$arg")
        continue
    fi
    case $arg in
        --)         passthrough=1 ;;
        --copy-env) copy_env=1 ;;
        --no-deps)  deps=0 ;;
        -*)         echo "worktree-add: неизвестный флаг: $arg" >&2; exit 2 ;;
        *)          args+=("$arg") ;;
    esac
done

ws_load || exit 2
root=$(ws_root)
projects_dir=$(ws_get projectsDir)
wt_dir=$(ws_get worktreesDir)

repo_arg=${args[0]:-}
repo_name=${repo_arg%/}
repo_name=${repo_name#"$projects_dir"/}
task=${args[1]:-}
base=${args[2]:-}

if [[ -z $task ]]; then
    echo "worktree-add: не задан код задачи" >&2
    usage >&2
    exit 2
fi

case $repo_name in
    ''|.*|*/*)
        echo "worktree-add: репозиторий — projects/<имя-репо> или <имя-репо>, получено «$repo_arg»" >&2
        exit 2 ;;
esac
case $task in
    .*|-*|*/*|*[!A-Za-z0-9_.-]*)
        echo "worktree-add: код задачи — одно имя каталога (латиница, цифры, _ . -), получено «$task»" >&2
        exit 2 ;;
esac

repo_rel=$(ws_repos | awk -F '\t' -v n="$repo_name" '$1 == n { print $2; exit }')
if [[ -z $repo_rel ]]; then
    echo "worktree-add: не репозиторий workspace — «$repo_arg»" >&2
    exit 2
fi
if [[ -z $base ]]; then
    base=$(node "$self_dir/lib/git.mjs" resolve "$root" "$repo_name" "$task" | awk -F '\t' '$1 == "base" { print $2 }')
    if [[ -z $base ]]; then
        echo "worktree-add: базу не определить — назови её третьим аргументом (node .claude/bin/git-base.mjs $repo_name $task скажет почему)" >&2
        exit 2
    fi
    # Локальная копия базы может отставать от сервера: ветка задачи растёт от origin/<база>.
    git -C "$root/$repo_rel" rev-parse --verify --quiet "origin/$base" >/dev/null && base="origin/$base"
fi
if [[ $repo_rel == . ]]; then
    repo=$root
    repo_disp="$repo_name (корень)"
else
    repo="$root/$repo_rel"
    repo_disp=$repo_rel
fi
wt_rel="$wt_dir/$task/$repo_name"
target="$root/$wt_rel"
setup_hook="$root/.claude/bin/worktree-setup"

if [[ -e $target ]]; then
    if [[ $copy_env -eq 0 ]]; then
        echo "worktree-add: каталог уже есть — $wt_rel" >&2
        echo "файлы окружения в него докладываются тем же вызовом с --copy-env" >&2
        exit 2
    fi
    if [[ ! -f $target/.git ]]; then
        echo "worktree-add: $wt_rel — не worktree, файлы окружения не кладу" >&2
        exit 2
    fi

    copied=0
    for env_file in .env .env.testing .env.local; do
        [[ -f $repo/$env_file ]] || continue
        if [[ -e $target/$env_file ]]; then
            echo "уже есть, не трогаю: $env_file"
            continue
        fi
        cp -- "$repo/$env_file" "$target/$env_file"
        echo "скопирован $env_file"
        copied=$((copied + 1))
    done
    [[ $copied -eq 0 ]] && echo "копировать нечего"

    # Хук здесь не зовётся сам: он уже отработал при создании, и повторять его без
    # ведома человека — значит, например, второй раз ставить зависимости.
    if [[ $copied -gt 0 && -x $setup_hook ]]; then
        echo
        echo "если проектной подготовке worktree нужны эти файлы — повтори её:"
        echo "  .claude/bin/worktree-setup $task $repo_name $target${setup_args[*]:+ ${setup_args[*]}}"
    fi
    exit 0
fi

mkdir -p -- "$root/$wt_dir/$task"

# Ветка задачи может уже существовать: тогда её не создают заново, а выкладывают.
if git -C "$repo" show-ref --verify --quiet "refs/heads/$task"; then
    echo "ветка $task уже есть, выкладываю её"
    git -C "$repo" worktree add "$target" "$task"
else
    git -C "$repo" worktree add "$target" -b "$task" "$base"
fi

present=()
for env_file in .env .env.testing .env.local; do
    [[ -f $repo/$env_file ]] && present+=("$env_file")
done

if [[ ${#present[@]} -eq 0 ]]; then
    echo "в $repo_disp файлов окружения нет — копировать нечего"
elif [[ $copy_env -eq 0 ]]; then
    echo
    echo "НЕ СКОПИРОВАНО: ${present[*]}"
    echo "в них лежат ключи, и они бывают боевыми — посмотри в файл сам."
    echo "убедился, что копия допустима — повтори вызов с флагом --copy-env:"
    echo "  .claude/bin/worktree-add $repo_name $task $base --copy-env"
else
    for env_file in "${present[@]}"; do
        cp -- "$repo/$env_file" "$target/$env_file"
        echo "скопирован $env_file"
    done
fi

# install_deps <инструмент> <команда…>: инструмента нет — подсказка и успех, упала — отказ.
install_deps() {
    local tool=$1
    shift
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "$tool в PATH нет — зависимости $wt_rel не поставлены, поставь сам: $*"
        return 0
    fi
    echo
    echo "зависимости: $*"
    if ! "$@"; then
        echo "worktree-add: установка зависимостей упала — worktree $wt_rel заведён, но не подготовлен." >&2
        echo "починив причину, повтори руками: $*" >&2
        exit 1
    fi
}

if [[ $deps -eq 1 ]]; then
    if [[ -f $target/pnpm-lock.yaml ]]; then
        install_deps pnpm pnpm --dir "$target" install --frozen-lockfile
    elif [[ -f $target/package-lock.json ]]; then
        install_deps npm npm --prefix "$target" ci
    elif [[ -f $target/package.json ]]; then
        echo "в $wt_rel package.json без pnpm-lock.yaml и package-lock.json — менеджер не угадываю, зависимости поставь сам"
    fi
    if [[ -f $target/composer.lock ]]; then
        install_deps composer composer install --working-dir="$target" --no-interaction
    fi
fi

if [[ -e $setup_hook ]]; then
    if [[ ! -x $setup_hook ]]; then
        echo "не зову .claude/bin/worktree-setup: файл есть, но не исполняемый" >&2
    else
        echo
        echo "проектная подготовка: .claude/bin/worktree-setup $task $repo_name${setup_args[*]:+ ${setup_args[*]}}"
        if ! WORKSPACE_ROOT="$root" "$setup_hook" "$task" "$repo_name" "$target" "${setup_args[@]}"; then
            echo "worktree-add: .claude/bin/worktree-setup упал — worktree $wt_rel заведён, но не подготовлен." >&2
            echo "починив причину, повтори руками:" >&2
            echo "  .claude/bin/worktree-setup $task $repo_name $target${setup_args[*]:+ ${setup_args[*]}}" >&2
            exit 1
        fi
    fi
fi

echo
echo "worktree готов: $wt_rel (база $base)"
