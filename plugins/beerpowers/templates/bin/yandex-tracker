#!/usr/bin/env bash
# generated by beerpowers v{{BEERPOWERS_VERSION}} — не править: обновляет /beerpowers:update
#
# yandex-tracker — постановка задачи из Яндекс Трекера в stdout, markdown'ом.
#
#     .claude/bin/yandex-tracker <КОД>
#     .claude/bin/yandex-tracker <КОД> --comments
#     .claude/bin/yandex-tracker <КОД> --comments-limit 3
#     .claude/bin/yandex-tracker <КОД> --json
#     .claude/bin/yandex-tracker <КОД> --comments --save memory/tasks/<КОД>/tracker
#
# <КОД> — ключ задачи вида <ОЧЕРЕДЬ>-<номер>.
#
# --comments-limit N оставляет последние N комментариев. Выключать ленту целиком
# смысла нет: в комментариях живёт то, чего нет в описании, — смена решения,
# разбор прошлой попытки, причина простоя.
#
# --save — штатная раскладка: описание уходит в <каталог>/task.md, вложения
# в <каталог>/task-attachment/ — каталог перед скачиванием очищается. Имена обобщённые намеренно: вложение может само
# называться по ключу задачи, и по имени файла было бы не отличить постановку
# от приложенного к ней документа. Точечные --out и --attachments тоже есть.
#
# Зачем скрипт, а не файл в репозитории: копия постановки расходится с трекером
# молча — задачу правят, а файл остаётся прежним, и команда делает не ту работу,
# будучи уверенной, что делает ту. Здесь постановка читается в момент работы.
#
# Доступы ищутся в трёх местах, первый непустой выигрывает:
#
#     1. переменные окружения
#     2. .claude/yandex-tracker-settings.json          — настройки этого проекта, под gitignore
#     3. ~/.claude/yandex-tracker-settings.json        — общие для всех проектов
#
# Токен у Трекера один на человека, а проектов много, поэтому обычное место —
# глобальный файл; проектный нужен, только если у проекта другая организация.
# Каждый ключ разрешается отдельно: orgId можно держать в проекте, токен — глобально.
#
#     YANDEX_TRACKER_TOKEN     OAuth-токен Яндекса с доступом к Трекеру
#     YANDEX_TRACKER_ORG_ID    идентификатор организации
#     YANDEX_TRACKER_ORG_TYPE  cloud | yandex360 — какой заголовок слать (необязательно)
#
# Про YANDEX_TRACKER_ORG_TYPE. У Трекера два вида организаций и два разных заголовка:
# X-Cloud-Org-ID для Yandex Cloud Organization и X-Org-ID для Яндекс 360.
# Какой нужен — зависит от того, как заведена организация, и снаружи не видно.
# Не задан тип — скрипт пробует cloud, на 401/403 повторяет с yandex360
# и печатает в stderr, какой сработал: подставь его в настройки, чтобы
# не платить лишним запросом каждый раз.
#
# Токен нигде не печатается: ни в выводе, ни в сообщениях об ошибках.

set -euo pipefail

api_host="https://api.tracker.yandex.net"
api_version="${YANDEX_TRACKER_API_VERSION:-v2}"
web_host="https://tracker.yandex.ru"

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
project_settings="$(cd -- "$self_dir/.." && pwd)/yandex-tracker-settings.json"
global_settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/yandex-tracker-settings.json"

usage() {
    awk 'NR > 3 && !/^#/ { exit } NR > 3 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

issue=""
want_comments=0
want_json=0
out_file=""
attachments_dir=""
clear_attachments=0
comments_limit=""

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --comments) want_comments=1 ;;
        --comments-limit)
            # Длинная лента комментариев вытесняет из контекста саму задачу, но выключать
            # её целиком нельзя: в комментариях живёт то, чего нет в описании — смена
            # решения, разбор прошлой попытки, причина простоя. Поэтому лента сужается,
            # а не отключается: последние N, самые свежие.
            [ $# -ge 2 ] || die "--comments-limit без числа"
            case "$2" in
                ''|*[!0-9]*) die "--comments-limit ждёт число, получено: $2" ;;
            esac
            comments_limit="$2"
            want_comments=1
            shift
            ;;
        --json) want_json=1 ;;
        --out)
            [ $# -ge 2 ] || die "--out без пути"
            out_file="$2"
            shift
            ;;
        --attachments)
            [ $# -ge 2 ] || die "--attachments без каталога"
            attachments_dir="$2"
            shift
            ;;
        --save)
            # Штатная раскладка артефактов задачи: описание — task.md, вложения —
            # в task-attachment/. Имена обобщённые намеренно: вложение может само
            # называться по ключу задачи, и тогда неясно, где постановка.
            [ $# -ge 2 ] || die "--save без каталога"
            out_file="$2/task.md"
            attachments_dir="$2/task-attachment"
            clear_attachments=1
            shift
            ;;
        -*) die "неизвестный флаг: $1 (см. --help)" ;;
        *)
            [ -z "$issue" ] || die "лишний аргумент: $1"
            issue="$1"
            ;;
    esac
    shift
done

[ -n "$issue" ] || { usage; exit 1; }

read_setting() {
    node -e '
        const fs = require("fs")
        try {
            const cfg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
            const v = cfg[process.argv[2]]
            if (typeof v === "string") process.stdout.write(v)
        } catch (e) {
            process.exit(0)
        }
    ' "$1" "$2"
}

# Порядок источников: окружение → настройки проекта → глобальные настройки.
# Значение подхватывается только там, где предыдущий источник промолчал, поэтому
# один токен в ~/.claude/yandex-tracker-settings.json обслуживает все проекты, а проектный
# файл нужен лишь там, где организация другая.
for file in "$project_settings" "$global_settings"; do
    [ -f "$file" ] || continue
    [ -n "${YANDEX_TRACKER_TOKEN:-}" ]    || YANDEX_TRACKER_TOKEN=$(read_setting "$file" token)
    [ -n "${YANDEX_TRACKER_ORG_ID:-}" ]   || YANDEX_TRACKER_ORG_ID=$(read_setting "$file" orgId)
    [ -n "${YANDEX_TRACKER_ORG_TYPE:-}" ] || YANDEX_TRACKER_ORG_TYPE=$(read_setting "$file" orgType)
done

[ -n "${YANDEX_TRACKER_TOKEN:-}" ] || die "нет YANDEX_TRACKER_TOKEN: задай переменную окружения либо заполни $global_settings (один на все проекты) или $project_settings (шаблон — .claude/yandex-tracker-settings.json.example)"
[ -n "${YANDEX_TRACKER_ORG_ID:-}" ] || die "нет YANDEX_TRACKER_ORG_ID: задай переменную окружения либо заполни $global_settings или $project_settings"

# Кладёт тело ответа в response_body, код — в http_code. Обе переменные глобальные
# намеренно: через подстановку `x=$(fetch …)` функция ушла бы в subshell, и код
# ответа до вызывающего не дошёл бы вовсе.
response_body=""
http_code=""

fetch() {
    local url="$1" org_header="$2" raw
    raw=$(curl -sS -w '\n%{http_code}' \
        -H "Authorization: OAuth ${YANDEX_TRACKER_TOKEN}" \
        -H "${org_header}: ${YANDEX_TRACKER_ORG_ID}" \
        "$url") || die "curl не смог сходить в $api_host (сеть, прокси, сертификат)"
    http_code="${raw##*$'\n'}"
    response_body="${raw%$'\n'*}"
}

org_header_for() {
    case "$1" in
        yandex360) printf 'X-Org-ID' ;;
        *)         printf 'X-Cloud-Org-ID' ;;
    esac
}

# Пробуем заданный тип организации; не задан — cloud, затем yandex360.
issue_url="$api_host/$api_version/issues/$issue"
if [ -n "${YANDEX_TRACKER_ORG_TYPE:-}" ]; then
    header=$(org_header_for "$YANDEX_TRACKER_ORG_TYPE")
    fetch "$issue_url" "$header"
else
    header="X-Cloud-Org-ID"
    fetch "$issue_url" "$header"
    if [ "$http_code" = "401" ] || [ "$http_code" = "403" ]; then
        header="X-Org-ID"
        fetch "$issue_url" "$header"
        [ "$http_code" = "200" ] && printf 'подошёл заголовок X-Org-ID — впиши "orgType": "yandex360" в настройки\n' >&2
    fi
fi
payload="$response_body"

case "$http_code" in
    200) ;;
    401) die "401: токен не принят. Проверь YANDEX_TRACKER_TOKEN — OAuth-токен Яндекса, не пароль" ;;
    403) die "403: доступ закрыт. Токен валиден, но прав на организацию ${YANDEX_TRACKER_ORG_ID} или на очередь нет; проверь и тип организации (orgType)" ;;
    404) die "404: задачи $issue в трекере нет — проверь ключ" ;;
    *)   die "HTTP $http_code от трекера" ;;
esac

if [ "$want_json" = "1" ]; then
    render='process.stdout.write(input)'
else
    render='
        const issue = JSON.parse(input)
        const comments = commentsRaw ? JSON.parse(commentsRaw) : null
        const person = (p) => (p && (p.display || p.id)) || "—"
        const date = (d) => (d ? String(d).slice(0, 10) : "—")
        const out = []

        out.push(`# ${issue.key} · ${issue.summary || ""}`.trim(), "")
        out.push("| Поле | Значение |", "|---|---|")
        out.push(`| Статус | ${person(issue.status)} |`)
        out.push(`| Тип | ${person(issue.type)} |`)
        out.push(`| Приоритет | ${person(issue.priority)} |`)
        out.push(`| Автор | ${person(issue.createdBy)} |`)
        out.push(`| Исполнитель | ${person(issue.assignee)} |`)
        if (issue.dueDate) out.push(`| Дедлайн | ${date(issue.dueDate)} |`)
        out.push(`| Создана | ${date(issue.createdAt)} |`)
        out.push(`| Обновлена | ${date(issue.updatedAt)} |`)
        out.push(`| Ссылка | ${web}/${issue.key} |`)
        out.push("")

        if (issue.description) out.push("## Описание", "", issue.description.trim(), "")

        const links = [issue.parent, ...(issue.links || []).map((l) => l.object)].filter(Boolean)
        if (links.length) {
            out.push("## Связанные", "")
            for (const l of links) out.push(`- ${l.key || l.id}`)
            out.push("")
        }

        if (comments && comments.length) {
            const limit = Number(process.env.YANDEX_TRACKER_COMMENTS_LIMIT || 0)
            const shown = limit > 0 ? comments.slice(-limit) : comments
            const head = limit > 0 && comments.length > shown.length
                ? `## Комментарии — показаны последние ${shown.length} из ${comments.length}`
                : `## Комментарии — ${comments.length}`
            out.push(head, "")
            for (const c of shown) {
                out.push(`### ${person(c.createdBy)} · ${date(c.createdAt)}`, "")
                out.push((c.text || "").trim(), "")
            }
        }

        process.stdout.write(out.join("\n").replace(/\n{3,}/g, "\n\n") + "\n")
    '
fi

comments_payload=""
if [ "$want_comments" = "1" ] && [ "$want_json" = "0" ]; then
    fetch "$issue_url/comments" "$header"
    [ "$http_code" = "200" ] || die "HTTP $http_code при запросе комментариев $issue"
    comments_payload="$response_body"
fi

result=$(YANDEX_TRACKER_INPUT="$payload" YANDEX_TRACKER_COMMENTS="$comments_payload" YANDEX_TRACKER_WEB="$web_host" YANDEX_TRACKER_COMMENTS_LIMIT="$comments_limit" node -e '
    const input = process.env.YANDEX_TRACKER_INPUT
    const commentsRaw = process.env.YANDEX_TRACKER_COMMENTS
    const web = process.env.YANDEX_TRACKER_WEB
    '"$render"'
')

# Вложения качаются по ссылке из поля content того же API, с теми же заголовками.
# Имена приходят как есть — с пробелами и кириллицей, поэтому список читается
# табулированными парами, а не через $(…) по пробелам.
if [ -n "$attachments_dir" ]; then
    fetch "$issue_url/attachments" "$header"
    [ "$http_code" = "200" ] || die "HTTP $http_code при запросе вложений $issue"

    # Вложения под gitignore: файл, который убрали из трекера, git не покажет удалённым,
    # а стёртый — не вернёт. Поэтому --save — снимок целиком и атомарно: всё качается
    # во временный каталог, и прежний заменяется только после последнего успешного файла.
    # Обрыв посередине оставляет прежние вложения на месте. Каталог из --attachments чужой —
    # туда качается напрямую, без замены.
    target="$attachments_dir"
    if [ "$clear_attachments" = "1" ]; then
        target=$(mktemp -d) || die "не создать временный каталог для вложений"
        trap 'rm -rf -- "$target"' EXIT
    fi
    mkdir -p "$target"
    saved=0
    while IFS=$'\t' read -r url name; do
        [ -n "$url" ] || continue
        # --fail: без него ответ трекера с ошибкой лёг бы на диск под именем вложения.
        curl -sS -L --fail -o "$target/$name" \
            -H "Authorization: OAuth ${YANDEX_TRACKER_TOKEN}" \
            -H "${header}: ${YANDEX_TRACKER_ORG_ID}" \
            "$url" || die "не скачалось: $name — прежние вложения не тронуты"
        saved=$((saved + 1))
    done <<< "$(YANDEX_TRACKER_ATTACHMENTS="$response_body" node -e '
        const list = JSON.parse(process.env.YANDEX_TRACKER_ATTACHMENTS)
        for (const a of list) {
            if (a.content && a.name) process.stdout.write(`${a.content}\t${a.name}\n`)
        }
    ')"

    if [ "$clear_attachments" = "1" ]; then
        # Разница с прошлой выгрузкой — здесь, потому что git её не видит.
        for f in "$target"/*; do
            [ -e "$f" ] || continue
            name=${f##*/}
            if [ ! -e "$attachments_dir/$name" ]; then
                printf 'вложение добавлено: %s\n' "$name" >&2
            elif ! cmp -s "$f" "$attachments_dir/$name"; then
                printf 'вложение заменено: %s\n' "$name" >&2
            fi
        done
        for f in "$attachments_dir"/*; do
            [ -e "$f" ] || continue
            [ -e "$target/${f##*/}" ] || printf 'вложение удалено: %s\n' "${f##*/}" >&2
        done
        mkdir -p "$(dirname -- "$attachments_dir")"
        backup=""
        if [ -d "$attachments_dir" ]; then
            backup="$attachments_dir.prev.$$"
            mv -- "$attachments_dir" "$backup" || die "не отодвинуть прежние вложения $attachments_dir"
        fi
        if ! mv -- "$target" "$attachments_dir"; then
            [ -z "$backup" ] || mv -- "$backup" "$attachments_dir"
            die "не перенести вложения в $attachments_dir — прежние возвращены"
        fi
        trap - EXIT
        [ -z "$backup" ] || rm -rf -- "$backup"
    fi
    printf 'вложений сохранено: %s в %s\n' "$saved" "$attachments_dir" >&2
fi

if [ -n "$out_file" ]; then
    mkdir -p "$(dirname -- "$out_file")"
    printf '%s\n' "$result" > "$out_file"
    printf 'записано: %s\n' "$out_file" >&2
else
    printf '%s\n' "$result"
fi
