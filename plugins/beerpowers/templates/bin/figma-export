#!/usr/bin/env bash
# generated by beerpowers v{{BEERPOWERS_VERSION}} — не править: обновляет /beerpowers:update
#
# figma-export — фрейм макета из Figma в PNG.
#
#     .claude/bin/figma-export 'https://www.figma.com/design/KEY/Name?node-id=1-234'
#     .claude/bin/figma-export '<URL>' --save <КОД>
#     .claude/bin/figma-export '<URL>' --out memory/tasks/<КОД>/figma/hover.png
#     .claude/bin/figma-export '<URL>' --scale 3
#
# Без --save и --out печатает только временную ссылку на рендер, ничего не качая.
# --save <КОД> кладёт файл в memory/tasks/<КОД>/figma/
# и берёт имя узла из Figma («Search / Empty» → search-empty.png); код задачи в имя файла
# не входит, его несёт каталог. Папка задачи memory/tasks/<КОД>/ должна уже существовать —
# опечатка в коде иначе завела бы новую папку задачи. Каталог figma/ под gitignore: макет —
# копия внешнего источника, в истории репозитория ему делать нечего (charter, раздел
# «Файлы памяти»).
#
# Корень workspace — каталог над .claude/. Переменная окружения WORKSPACE_ROOT его
# переопределяет: так скрипт проверяют на одноразовой фикстуре.
#
# node-id в адресе браузера пишется через дефис (1-234), в API — через двоеточие (1:234);
# скрипт конвертирует сам. Нет node-id в ссылке — значит выделен весь файл, а не фрейм:
# так экспортировать нечего, попроси ссылку на конкретный фрейм (Copy link to selection).
#
# Доступ ищется в трёх местах, первый непустой выигрывает:
#
#     1. переменная окружения FIGMA_TOKEN
#     2. .claude/figma-settings.json          — настройки этого проекта, под gitignore
#     3. ~/.claude/figma-settings.json        — общие для всех проектов
#
# Токен персональный (figma.com → Settings → Security → Personal access tokens),
# нужен scope на чтение файлов. Как и у трекера, обычное место — глобальный файл.
# Значение токена нигде не печатается.

set -euo pipefail

api="https://api.figma.com/v1"

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
. "$self_dir/lib/workspace.sh"
project_settings="$(cd -- "$self_dir/.." && pwd)/figma-settings.json"
global_settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/figma-settings.json"

usage() {
    awk 'NR > 3 && !/^#/ { exit } NR > 3 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

url=""
save_code=""
out_file=""
scale="2"

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --save)
            [ $# -ge 2 ] || die "--save без кода задачи"
            case "$2" in
                ""|.*|-*|*[!A-Za-z0-9_.-]*) die "--save ждёт код задачи — одно имя каталога в memory/tasks/, получено: $2" ;;
            esac
            save_code="$2"; shift ;;
        --out)
            [ $# -ge 2 ] || die "--out без пути"
            out_file="$2"; shift ;;
        --scale)
            [ $# -ge 2 ] || die "--scale без числа"
            case "$2" in ''|*[!0-9.]*) die "--scale ждёт число, получено: $2" ;; esac
            scale="$2"; shift ;;
        -*) die "неизвестный флаг: $1 (см. --help)" ;;
        *)
            [ -z "$url" ] || die "лишний аргумент: $1"
            url="$1" ;;
    esac
    shift
done

[ -n "$url" ] || { usage; exit 1; }

ws_load || exit 1
root=$(ws_root)
tasks_dir=$(ws_get tasksDir)
if [ -n "$save_code" ]; then
    [ -d "$root/$tasks_dir/$save_code" ] || die "папки задачи $tasks_dir/$save_code нет — проверь код или заведи задачу"
fi

read_setting() {
    node -e '
        const fs = require("fs")
        try {
            const cfg = JSON.parse(fs.readFileSync(process.argv[1], "utf8"))
            const v = cfg[process.argv[2]]
            if (typeof v === "string") process.stdout.write(v)
        } catch (e) { process.exit(0) }
    ' "$1" "$2"
}

for file in "$project_settings" "$global_settings"; do
    [ -f "$file" ] || continue
    [ -n "${FIGMA_TOKEN:-}" ] || FIGMA_TOKEN=$(read_setting "$file" token)
done

[ -n "${FIGMA_TOKEN:-}" ] || die "нет FIGMA_TOKEN: задай переменную окружения либо заполни $global_settings (один на все проекты) или $project_settings (шаблон — .claude/figma-settings.json.example)"

# Ключ файла и узел из адреса. Figma отдаёт и /design/, и старый /file/.
# sed -E намеренно: в BRE альтернатива внутри группы (\|) этой сборкой не разбирается
# и выражение молча не матчит — ключ выходил пустым на корректной ссылке.
key=$(printf '%s' "$url" | sed -nE 's|.*figma\.com/(design\|file\|proto)/([A-Za-z0-9]{10,}).*|\2|p')
[ -n "$key" ] || die "в ссылке нет ключа файла Figma — ожидается вид https://www.figma.com/design/<KEY>/<Name>?node-id=1-234"

node_raw=$(printf '%s' "$url" | sed -n 's|.*[?&]node-id=\([^&]*\).*|\1|p')
[ -n "$node_raw" ] || die "в ссылке нет node-id: выделен весь файл, а не фрейм. В Figma — правый клик по фрейму, «Copy link to selection»"
node_id=$(printf '%s' "$node_raw" | sed 's/%3A/:/I; s/-/:/')

fetch() {
    curl -sS -w '\n%{http_code}' -H "X-Figma-Token: ${FIGMA_TOKEN}" "$1"
}

# Имя узла — для осмысленного имени файла. Ошибка здесь не фатальна: без имени
# файл назовётся по node-id, но экспорт всё равно нужнее имени.
#
# depth=1 отсекает поддерево: нужен только сам узел, а у страницы или крупной секции
# полный ответ весит мегабайты. Он же уходит в node через stdin, а не переменной
# окружения — argv и env делят общий лимит, и на большом фрейме exec падал с
# «Argument list too long», не сохранив фрейм вовсе.
node_name=""
meta=$(fetch "$api/files/$key/nodes?ids=$node_id&depth=1" || true)
if [ "${meta##*$'\n'}" = "200" ]; then
    node_name=$(printf '%s' "${meta%$'\n'*}" | NODE_ID="$node_id" node -e '
        let raw = ""
        process.stdin.on("data", (chunk) => { raw += chunk })
        process.stdin.on("end", () => {
            try {
                const d = JSON.parse(raw)
                const n = d.nodes?.[process.env.NODE_ID]?.document?.name || ""
                process.stdout.write(n.toLowerCase().replace(/[^a-zа-я0-9]+/gi, "-").replace(/^-|-$/g, "").slice(0, 60))
            } catch (e) { process.exit(0) }
        })
    ' || true)
fi

body=$(fetch "$api/images/$key?ids=$node_id&format=png&scale=$scale")
code="${body##*$'\n'}"
payload="${body%$'\n'*}"

case "$code" in
    200) ;;
    403) die "403: токен не принят или нет доступа к файлу. Проверь FIGMA_TOKEN и что файл открыт этому аккаунту" ;;
    404) die "404: файла $key нет или он недоступен" ;;
    429) die "429: Figma ограничила частоту запросов — подожди и повтори" ;;
    *)   die "HTTP $code от Figma" ;;
esac

image_url=$(FIGMA_PAYLOAD="$payload" NODE_ID="$node_id" node -e '
    const d = JSON.parse(process.env.FIGMA_PAYLOAD)
    if (d.err) { process.stderr.write(String(d.err) + "\n"); process.exit(1) }
    const u = d.images?.[process.env.NODE_ID]
    if (!u) { process.stderr.write("узел не отрендерился — проверь node-id\n"); process.exit(1) }
    process.stdout.write(u)
')

if [ -z "$out_file" ] && [ -n "$save_code" ]; then
    name=${node_name:-$(printf '%s' "$node_id" | tr ':' '-')}
    out_file="$root/$tasks_dir/$save_code/figma/$name.png"
fi

if [ -z "$out_file" ]; then
    printf '%s\n' "$image_url"
    printf 'ссылка временная. Скачать: --save <КОД> или --out <путь>\n' >&2
    exit 0
fi

mkdir -p "$(dirname -- "$out_file")"
curl -sS -L -o "$out_file" "$image_url" || die "не скачалось: $out_file"
printf 'сохранено: %s (%s)\n' "${out_file#"$root/"}" "$(du -h "$out_file" | cut -f1)"
