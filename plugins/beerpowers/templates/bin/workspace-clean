#!/usr/bin/env bash
# generated by beerpowers v{{BEERPOWERS_VERSION}} — не править: обновляет /beerpowers:update
#
# workspace-clean — уборка рабочих деревьев задач, артефактов сборки, медиа задачи и кеша.
#
#     .claude/bin/workspace-clean worktree <КОД>          # снять worktree'и worktrees/<КОД>/<имя-репо>
#     .claude/bin/workspace-clean orphans                 # каталоги worktrees/*/*, о которых git не знает
#     .claude/bin/workspace-clean output                  # .output во всех репозиториях и worktrees/*/*
#     .claude/bin/workspace-clean output <КОД>            # .output только в worktrees/<КОД>/*
#     .claude/bin/workspace-clean output <имя-репо>       # .output только в основном каталоге репозитория
#     .claude/bin/workspace-clean task <КОД>              # медиа задачи в memory/tasks/<КОД>/, пустой каталог задачи
#     .claude/bin/workspace-clean cache                   # только кеш .claude/.cache
#     .claude/bin/workspace-clean worktree <КОД> --apply
#
# По умолчанию — **сухой прогон**: печатает, что удалил бы. Реальное удаление
# только с --apply.
#
# Каждый вызов, любой формы, в конце убирает и кеш .claude/.cache (см. ниже, `cache`) —
# в сухом прогоне сухо, с --apply по-настоящему. Флаги кеша, у любой формы:
#     --keep-days <дней>   порог возраста прогонов тестов и состояния хуков (по умолчанию 7)
#     --no-cache           кеш не трогать
#
# Раскладка — константы движка: рабочие деревья задач —
# worktrees/<КОД>/<имя-репо>/, медиа задачи под gitignore — фреймы Figma
# memory/tasks/<КОД>/figma/, скриншоты memory/tasks/<КОД>/screenshots/ и вложения трекера
# memory/tasks/<КОД>/tracker/task-attachment/. Репозитории — по правилу обхода:
# каталоги projects/* с .git.
#
# Корень workspace — каталог над .claude/. Переменная окружения WORKSPACE_ROOT его
# переопределяет: так скрипт проверяют на одноразовой фикстуре, не задевая живые репозитории.
#
# Зачем скрипт. `rm -rf` стоит в deny проектного settings.json, и это правильно: маска
# разрешений матчит префикс команды, поэтому любое послабление вида `Bash(rm -rf …:*)`
# открывает удаление чего угодно, включая репозиторий с несданной работой. Здесь барьер
# переезжает из масок в код: скрипт умеет удалять только то, что прошло его проверки,
# а deny на голый `rm -rf` остаётся в силе.
#
# Отказывается работать, если:
#   * путь выходит за workspace, содержит .. или не подходит ни под одну разрешённую форму;
#   * каталог — основной каталог репозитория;
#   * в worktree есть незакоммиченное;
#   * ветка не влита ни в ветку по умолчанию, ни в базу задачи из её git-flow.md — влитость
#     считает lib/git.mjs, по предкам или по патчу (снимается флагом --merged-anyway, и тогда
#     скрипт печатает, что именно теряется);
#   * каталог осиротел, а --orphan не передан: состояние такого дерева проверить нечем;
#   * в каталогах медиа задачи лежат файлы под версионным контролем;
#   * проектный хук уборки завершился с ошибкой;
#   * каталог кеша или его подкаталог, по которому идёт уборка, — символьная ссылка.
#
# Проектная уборка worktree — своя тестовая база, контейнеры, что угодно, заведённое под
# дерево, — не здесь. Если в проекте есть исполняемый .claude/bin/worktree-teardown,
# `worktree --apply` зовёт его перед снятием деревьев, по разу на дерево, с аргументами
# <КОД> <имя-репо> <абсолютный путь worktree> и WORKSPACE_ROOT в окружении. Ненулевой код —
# отказ, ни одно дерево не снимается. Все хуки отрабатывают раньше первого удаления, поэтому
# хук обязан быть идемпотентным: после отказа на втором дереве повторный вызов пройдёт
# уборку первого ещё раз. Сухой прогон зовёт хук с --dry-run, только если тот объявил это
# строкой `# supports: --dry-run` в шапке, — иначе только называет: хук, не знающий флага,
# выполнил бы уборку по-настоящему.
#
# `task` нужен после `git rm` артефактов задачи: игнорируемые каталоги медиа git
# не убирает, и каталог задачи остаётся висеть. Каталог задачи удаляется, только если
# после уборки медиа в нём не осталось ни одного файла.
#
# Уборка кеша — она же форма `cache` без остального — убирает в .claude/.cache то, что копится
# от прогонов, и только это:
#   * копии деревьев мутантов (.claude/.cache/mutants/) — зовёт `mutants.mjs --clean`: он
#     снимает регистрацию git worktree и пропускает слот, который держит идущий прогон.
#     Убранную копию следующий прогон мутантов пересоздаст — теряется время подготовки, не данные;
#   * прогоны parallel-tests (.claude/.cache/parallel-tests/runs/<время>-<pid>/) старше
#     --keep-days, кроме прогона с живым pid: идущий прогон пишет туда логи. Длительности тестов
#     parallel-tests/<репо>.junit.xml нужны раскладке и остаются всегда;
#   * состояние напоминания о скриншотах (.claude/.cache/screenshots-reminder/<сессия>/)
#     старше --keep-days.
# Состояние барьеров и команд в корне кеша (comment-guard, push-lost, user-files-window,
# task-start, tracker) и чужие файлы скрипт только называет. По символьным ссылкам не ходит.

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
. "$self_dir/lib/workspace.sh"

usage() {
    awk 'NR > 3 && !/^#/ { exit } NR > 3 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

apply=0
orphan_ok=0
merged_anyway=0
keep_days=""
no_cache=0
mode=""
target=""

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --apply) apply=1 ;;
        --orphan) orphan_ok=1 ;;
        --merged-anyway) merged_anyway=1 ;;
        --keep-days)
            [ $# -gt 1 ] || die "--keep-days: нет значения"
            shift
            case "$1" in ""|*[!0-9]*) die "--keep-days: ждётся целое число дней, а не «$1»" ;; esac
            keep_days=$1
            ;;
        --no-cache) no_cache=1 ;;
        -*) die "неизвестный флаг: $1 (см. --help)" ;;
        worktree|orphans|output|task|cache)
            [ -z "$mode" ] || die "режим уже задан: $mode"
            mode="$1"
            ;;
        *)
            [ -n "$mode" ] || die "сначала режим: worktree | orphans | output | task | cache"
            [ -z "$target" ] || die "лишний аргумент: $1"
            target="$1"
            ;;
    esac
    shift
done

[ -n "$mode" ] || { usage; exit 1; }
[ "$no_cache" = "0" ] || [ "$mode" != "cache" ] || die "cache --no-cache — уборка кеша без уборки кеша"
[ -z "$keep_days" ] || [ "$no_cache" = "0" ] || die "--keep-days — порог уборки кеша, а --no-cache её выключает"

ws_load || exit 1
root=$(ws_root)
wt_dir=$(ws_get worktreesDir)
tasks_dir=$(ws_get tasksDir)
repo_list=$(ws_repos)
gitlib="$self_dir/lib/git.mjs"
tab=$(printf '\t')

# Одно имя каталога: код задачи, имя репозитория. Ни слэшей, ни точки в начале — значит,
# ни `..`, ни служебных каталогов.
is_name() {
    case "$1" in
        ""|.*|-*|*[!A-Za-z0-9_.-]*) return 1 ;;
    esac
    return 0
}

# Имена репозиториев по правилу обхода — они же белый список имён worktree.
repos() {
    printf '%s\n' "$repo_list" | while IFS="$tab" read -r n _; do
        is_name "$n" && printf '%s\n' "$n"
    done
    return 0
}

is_repo() {
    for r in $(repos); do
        [ "$1" = "$r" ] && return 0
    done
    return 1
}

# Путь основного каталога репозитория от корня: projects/<имя>.
repo_path() {
    printf '%s\n' "$repo_list" | awk -F '\t' -v n="$1" '$1 == n { print $2; exit }'
}

repo_abs() {
    rp=$(repo_path "$1")
    printf '%s\n' "$root/$rp"
}

repo_output() {
    rp=$(repo_path "$1")
    printf '%s/.output\n' "$rp"
}

# Цели влитости ветки задачи в репозитории: origin/<ветка по умолчанию> и origin/<база задачи>
# из memory/tasks/<КОД>/git-flow.md, если она там названа. Только те, что есть локально.
merge_targets_of() {
    _mt_default=$(node "$gitlib" defaults "$root" "$1" 2>/dev/null | awk -F '\t' '$1 == "base" { print $2 }')
    _mt_task=$(node "$gitlib" task "$root" "$2" 2>/dev/null | awk -F '\t' -v r="$1" '$1 == r && $2 != "-" { print $2 }')
    for _mt in $_mt_default $_mt_task; do
        git -C "$3" rev-parse --verify --quiet "origin/$_mt" >/dev/null 2>&1 && printf 'origin/%s
' "$_mt"
    done
    return 0
}

# Дерево пересборки стенда — worktrees/chore-<стенд>-rebuild/<имя-репо> (git-flow.md,
# «Стенды»): стенд в ветку по умолчанию не вливается никогда, поэтому его дерево проверяется
# не на влитость, а на то, что вершина уже отправлена в origin/<стенд>. Имя стенда берётся
# из имени каталога — списка стендов в настройках нет.
stand=""
case "$target" in
    chore-?*-rebuild) stand=${target#chore-}; stand=${stand%-rebuild} ;;
esac

# Единственное место, где вызывается rm -rf. Разрешение выдаётся по **белому списку форм**,
# а не запретом опасного: фильтр «всё, кроме репозиториев» в сухом прогоне предлагает снести
# соседние каталоги памяти. Негативный фильтр всегда неполон — перечислять надо то, что можно,
# а не то, что нельзя.
#
# Удалять разрешено ровно эти формы:
#   worktrees/<КОД>/<имя-репо>            рабочее дерево задачи (worktree или его сирота)
#   worktrees/<КОД>/<имя-репо>/.output    артефакт сборки в рабочем дереве
#   <путь-репо>/.output                        артефакт сборки в основном каталоге репозитория
#   memory/tasks/<КОД>/figma                     фреймы макета задачи
#   memory/tasks/<КОД>/screenshots                     скриншоты прогонов задачи
#   memory/tasks/<КОД>/tracker/task-attachment   вложения из трекера
#   .claude/.cache/parallel-tests/runs/<имя>     логи прогона тестов
#   .claude/.cache/screenshots-reminder/<имя>    состояние напоминания о скриншотах за сессию
remove_tree() {
    path=$1

    case "$path" in
        ""|"."|".."|/*|*..*) die "отказ: подозрительный путь «$path»" ;;
    esac
    abs=$(cd -- "$(dirname -- "$root/$path")" 2>/dev/null && pwd)/$(basename -- "$path")
    case "$abs" in
        "$root"/*) ;;
        *) die "отказ: «$path» выходит за пределы workspace" ;;
    esac

    allowed=0
    case "$path" in
        "$wt_dir"/*)
            IFS=/ read -r p1 p2 p3 p4 <<EOF
${path#"$wt_dir"/}
EOF
            if is_name "$p1" && is_repo "$p2" && [ -z "$p4" ]; then
                [ -z "$p3" ] && allowed=1
                [ "$p3" = ".output" ] && allowed=1
            fi
            ;;
        "$tasks_dir"/*)
            IFS=/ read -r p1 p2 p3 p4 <<EOF
${path#"$tasks_dir"/}
EOF
            if is_name "$p1" && [ -z "$p4" ]; then
                case "$p2/$p3" in figma/|screenshots/|tracker/task-attachment) allowed=1 ;; esac
            fi
            ;;
        .claude/.cache/*)
            IFS=/ read -r p1 p2 p3 p4 <<EOF
${path#.claude/.cache/}
EOF
            if [ -z "$p4" ]; then
                [ "$p1/$p2" = "parallel-tests/runs" ] && is_name "$p3" && allowed=1
                [ "$p1" = "screenshots-reminder" ] && is_name "$p2" && [ -z "$p3" ] && allowed=1
            fi
            ;;
        *)
            for r in $(repos); do
                [ "$path" = "$(repo_path "$r")" ] && die "отказ: «$path» — основной каталог репозитория $r"
                if [ "$path" = "$(repo_output "$r")" ]; then
                    allowed=1
                    break
                fi
            done
            ;;
    esac

    [ "$allowed" = "1" ] || die "отказ: «$path» не подходит ни под одну разрешённую форму ($wt_dir/<КОД>/<имя-репо>, <репо>/.output, $tasks_dir/<КОД>/figma|screenshots|tracker/task-attachment, .claude/.cache/parallel-tests/runs/<имя>, .claude/.cache/screenshots-reminder/<имя>)"

    if [ "$apply" = "1" ]; then
        rm -rf "$root/$path"
        printf 'удалено: %s\n' "$path"
    else
        printf 'удалил бы: %s\n' "$path"
    fi
}

# Каталог-контейнер (worktrees/<КОД>, memory/tasks/<КОД>) убирается не rm -rf, а только
# как пустой: find -empty -delete физически не может снести файл. В сухом прогоне
# содержимое, которое останется, считается без учёта того, что удалил бы remove_tree.
remove_if_empty() {
    path=$1
    shift
    case "$path" in
        "$wt_dir"/*) rest=${path#"$wt_dir"/} ;;
        "$tasks_dir"/*) rest=${path#"$tasks_dir"/} ;;
        *) die "отказ: «$path» — не каталог-контейнер" ;;
    esac
    case "$rest" in
        */*) die "отказ: «$path» — не каталог-контейнер" ;;
    esac
    is_name "$rest" || die "отказ: подозрительный путь «$path»"
    [ -d "$root/$path" ] || return 0

    left=$(cd -- "$root/$path" && find . -mindepth 1 ! -type d | while IFS= read -r f; do
        f=${f#./}
        skip=0
        for gone in "$@"; do
            case "$f" in "$gone"/*) skip=1 ;; esac
        done
        [ "$skip" = "1" ] || printf '%s\n' "$f"
    done)

    if [ -n "$left" ]; then
        printf 'оставлен: %s — в нём остаются файлы:\n%s\n' "$path" "$(printf '%s\n' "$left" | head -10 | sed 's/^/  /')"
        return 0
    fi
    if [ "$apply" = "1" ]; then
        find "$root/$path" -depth -type d -empty -delete
        if [ -d "$root/$path" ]; then
            printf 'оставлен: %s — не пуст\n' "$path"
        else
            printf 'удалено: %s (пустой)\n' "$path"
        fi
    else
        printf 'удалил бы: %s (останется пустым)\n' "$path"
    fi
}

case "$mode" in
    worktree)
        [ -n "$target" ] || die "нужен код задачи: workspace-clean worktree <КОД>"
        is_name "$target" || die "код задачи — одно имя каталога в $wt_dir/, без слэшей и точки в начале: «$target»"
        [ -d "$root/$wt_dir/$target" ] || die "каталога $wt_dir/$target нет"

        # Три прохода: проверки по всем деревьям задачи, затем проектные хуки уборки, затем
        # удаление. Иначе отказ на втором дереве настиг бы уже снятое первое.
        found=""
        for r in $(repos); do
            wt="$wt_dir/$target/$r"
            [ -d "$root/$wt" ] || continue
            found="$found $r"
            repo=$(repo_abs "$r")

            if [ -e "$root/$wt/.git" ]; then
                dirty=$(git -C "$root/$wt" status --porcelain 2>/dev/null | head -20)
                [ -z "$dirty" ] || die "отказ: в $wt есть незакоммиченное:
$dirty"

                branch=$(git -C "$root/$wt" branch --show-current 2>/dev/null || true)
                # Detached HEAD — ветки нет, но коммиты на ней есть и теряются вместе с деревом:
                # проверяем влитость самого HEAD, а не пропускаем проверку.
                keep_note="ветка при этом остаётся в репозитории"
                detached=0
                if [ -z "$branch" ]; then
                    branch=$(git -C "$root/$wt" rev-parse HEAD 2>/dev/null || true)
                    detached=1
                    keep_note="ветки нет — сначала заведи её на этом коммите (git -C $wt branch <имя>), иначе коммиты потеряются"
                fi
                if [ -n "$branch" ] && [ "$merged_anyway" = "0" ] && [ -n "$stand" ]; then
                    git -C "$repo" merge-base --is-ancestor "$branch" "origin/$stand" 2>/dev/null \
                        || die "отказ: вершина $wt не отправлена в origin/$stand — пересборка не закончена или push не прошёл.
Отправленная пересборка снимается этой же командой; бросить неотправленную — --merged-anyway."
                    branch=""
                fi
                if [ -n "$branch" ] && [ "$merged_anyway" = "0" ]; then
                    targets=$(merge_targets_of "$r" "$target" "$repo")
                    [ -n "$targets" ] || die "отказ: ветку $branch в $wt не с чем сравнить — ветка по умолчанию не узнана (сервер не ответил или профиль custom без базы в git-flow.md задачи).
Каталог удалить всё равно можно ($keep_note): добавь --merged-anyway."
                    # shellcheck disable=SC2086
                    verdict=$(node "$gitlib" merged "$root" "$r" "$branch" $targets 2>/dev/null)
                    if ! printf '%s\n' "$verdict" | awk -F '\t' '$2 == "влита" { found = 1 } END { exit !found }'; then
                        die "отказ: ветка $branch в $wt не влита ни в одну цель: $(printf '%s\n' "$verdict" | awk -F '\t' '{ printf "%s%s — %s", sep, $1, $3; sep = "; " }').
Каталог удалить всё равно можно ($keep_note): добавь --merged-anyway."
                    fi
                fi
            else
                [ "$orphan_ok" = "1" ] || die "отказ: $wt осиротел — git о нём не знает, незакоммиченное проверить нечем. Осознанно убрать: --orphan"
            fi
        done

        [ -n "$found" ] || die "в $wt_dir/$target нет ни одного каталога с именем репозитория workspace"

        teardown="$root/.claude/bin/worktree-teardown"
        if [ -e "$teardown" ]; then
            if [ ! -x "$teardown" ]; then
                printf 'не зову .claude/bin/worktree-teardown: файл есть, но не исполняемый\n' >&2
            else
                for r in $found; do
                    wt="$wt_dir/$target/$r"
                    if [ "$apply" = "1" ]; then
                        WORKSPACE_ROOT="$root" "$teardown" "$target" "$r" "$root/$wt" \
                            || die "отказ: .claude/bin/worktree-teardown $target $r завершился с кодом $? — ни одно дерево не снято"
                    elif grep -q '^# supports: --dry-run' "$teardown" 2>/dev/null; then
                        printf 'вызвал бы: .claude/bin/worktree-teardown %s %s %s — его сухой прогон:\n' "$target" "$r" "$root/$wt"
                        WORKSPACE_ROOT="$root" "$teardown" "$target" "$r" "$root/$wt" --dry-run 2>&1 | sed 's/^/    /'
                    else
                        printf 'вызвал бы: .claude/bin/worktree-teardown %s %s %s\n' "$target" "$r" "$root/$wt"
                    fi
                done
            fi
        fi

        for r in $found; do
            wt="$wt_dir/$target/$r"
            repo=$(repo_abs "$r")

            # НЕ убирать это условие: без него сухой прогон снимает регистрацию
            # и стирает файлы worktree по-настоящему, вопреки собственному контракту
            # «--apply нужен для реального удаления».
            if [ "$apply" = "1" ] && [ -e "$root/$wt/.git" ]; then
                git -C "$repo" worktree remove --force "$root/$wt" 2>/dev/null || true
                git -C "$repo" worktree prune 2>/dev/null || true
            fi

            remove_tree "$wt"
        done

        # shellcheck disable=SC2086
        remove_if_empty "$wt_dir/$target" $found
        ;;

    orphans)
        registered=$(for r in $(repos); do git -C "$(repo_abs "$r")" worktree list 2>/dev/null | tail -n +2 | awk '{print $1}'; done)
        any=0
        # Перебираются не «все каталоги, кроме известных», а имена репозиториев
        # внутри каждого worktrees/<КОД>/. Посторонний каталог только называется.
        for dir in "$root/$wt_dir"/*/; do
            [ -d "$dir" ] || continue
            code=$(basename -- "$dir")
            is_name "$code" || continue
            for sub in "$dir"*/; do
                [ -d "$sub" ] || continue
                name=$(basename -- "$sub")
                [ -e "$sub.git" ] && continue
                abs=$(cd -- "$sub" && pwd)
                printf '%s\n' "$registered" | grep -qiF "$abs" && continue
                any=1
                if is_repo "$name"; then
                    remove_tree "$wt_dir/$code/$name"
                else
                    printf 'не трогаю: %s/%s/%s — имени нет среди репозиториев workspace, разбери руками\n' "$wt_dir" "$code" "$name"
                fi
            done
        done
        [ "$any" = "1" ] || echo "осиротевших каталогов нет"
        ;;

    output)
        # Без цели чистится весь workspace, включая worktree соседних задач, которые
        # могут опираться на свою сборку. Цель сужает уборку: код задачи — её рабочие
        # деревья, имя репозитория — его основной каталог.
        scope_wt='*'
        scope_repo='*'
        if [ -n "$target" ]; then
            is_name "$target" || die "цель — код задачи или имя репозитория, одно имя: «$target»"
            if [ -d "$root/$wt_dir/$target" ]; then
                scope_repo=""
                scope_wt=$target
            elif is_repo "$target"; then
                scope_wt=""
                scope_repo=$target
            else
                die "ни $wt_dir/$target, ни репозитория $target нет"
            fi
        fi
        any=0
        if [ -n "$scope_repo" ]; then
            for r in $(repos); do
                [ "$scope_repo" = "*" ] || [ "$scope_repo" = "$r" ] || continue
                out=$(repo_output "$r")
                [ -d "$root/$out" ] || continue
                any=1
                remove_tree "$out"
            done
        fi
        if [ -n "$scope_wt" ]; then
            # shellcheck disable=SC2231
            for dir in "$root/$wt_dir"/$scope_wt/*/.output; do
                [ -d "$dir" ] || continue
                any=1
                remove_tree "${dir#"$root/"}"
            done
        fi
        [ "$any" = "1" ] || echo "каталогов .output нет"
        ;;

    task)
        [ -n "$target" ] || die "нужен код задачи: workspace-clean task <КОД>"
        is_name "$target" || die "код задачи — одно имя каталога в $tasks_dir/, без слэшей и точки в начале: «$target»"
        dir="$tasks_dir/$target"
        [ -d "$root/$dir" ] || die "каталога $dir нет"

        # Под gitignore эти каталоги по замыслу; файл под версионным контролем внутри —
        # чья-то ошибка раскладки, и молча стирать его из рабочего дерева нельзя.
        git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
            || die "отказ: $root — не репозиторий git, проверить, что медиа задачи не версионируются, нечем"
        tracked=$(git -C "$root" ls-files -- "$dir/figma" "$dir/screenshots" "$dir/tracker/task-attachment" | head -10)
        [ -z "$tracked" ] || die "отказ: в медиа $dir есть файлы под git — сначала git rm:
$tracked"

        gone=""
        for sub in figma screenshots tracker/task-attachment; do
            [ -d "$root/$dir/$sub" ] || continue
            n=$(find "$root/$dir/$sub" ! -type d | wc -l | tr -d ' ')
            printf '%s/%s: файлов %s\n' "$dir" "$sub" "$n"
            remove_tree "$dir/$sub"
            gone="$gone $sub"
        done
        [ -n "$gone" ] || echo "в $dir нет ни figma/, ни screenshots/, ни tracker/task-attachment/"

        # shellcheck disable=SC2086
        remove_if_empty "$dir" $gone
        ;;

    cache)
        [ -z "$target" ] || die "у cache нет цели: workspace-clean cache [--keep-days <дней>] [--apply]"
        ;;
esac

# Кеш — хвост каждого вызова, не только формы cache: копии мутантов и логи прогонов
# копятся от работы над задачами, и уборка, о которой надо помнить, не случается.
# Сухой прогон формы — сухой и здесь; --no-cache выключает хвост.
cache=.claude/.cache
cache_status=0
if [ "$no_cache" = "1" ]; then
    :
elif [ ! -d "$root/$cache" ]; then
    [ "$mode" != "cache" ] || echo "каталога $cache нет — убирать нечего"
else
    [ "$mode" = "cache" ] || printf '\nкеш %s (--no-cache — без него):\n' "$cache"
    days=${keep_days:-7}
    for d in "$cache" "$cache/mutants" "$cache/parallel-tests" "$cache/parallel-tests/runs" "$cache/screenshots-reminder"; do
        if [ -L "$root/$d" ]; then
            die "отказ: $d — символьная ссылка, уборка по ней ушла бы за пределы кеша"
        fi
    done
    verb="убрано"
    [ "$apply" = "1" ] || verb="убрал бы"
    status=0

    # Копии мутантов — их собственной уборкой: проверка занятых слотов и снятие
    # регистрации git worktree живут в mutants.mjs, второй копии этой логики здесь нет.
    mut_gone=0
    mut_busy=0
    if [ -n "$(ls -A "$root/$cache/mutants" 2>/dev/null)" ]; then
        if [ -f "$self_dir/mutants.mjs" ]; then
            dry=--dry-run
            [ "$apply" = "1" ] && dry=""
            # shellcheck disable=SC2086
            if mout=$(node "$self_dir/mutants.mjs" --clean $dry 2>&1); then
                printf '%s\n' "$mout" | sed -n "s|^убрал бы: |удалил бы: $cache/mutants/|p; s|^убрана: |удалено: $cache/mutants/|p; s|^занята: |занята: $cache/mutants/|p"
                mut_gone=$(printf '%s\n' "$mout" | grep -c '^убра' || true)
                mut_busy=$(printf '%s\n' "$mout" | grep -c '^занята:' || true)
            else
                status=1
                printf 'копии мутантов не убраны — mutants.mjs --clean завершился с ошибкой:\n%s\n' "$(printf '%s\n' "$mout" | sed 's/^/  /')"
            fi
        else
            printf 'не трогаю: %s/mutants — копии .claude/bin/mutants.mjs нет, а снимать копии умеет только она\n' "$cache"
        fi
    fi

    # Прогоны parallel-tests: каталог <время>-<pid>. Идущий прогон пишет туда логи, поэтому
    # прогон с живым pid остаётся при любом возрасте. Живость — у node: pid в имени —
    # системный, а kill -0 Git Bash видит только свои процессы.
    runs="$cache/parallel-tests/runs"
    runs_gone=0
    runs_live=0
    runs_fresh=0
    if [ -d "$root/$runs" ]; then
        old=$(cd -- "$root/$runs" && find . -mindepth 1 -maxdepth 1 -type d -mmin "+$((days * 1440))" | sed 's|^\./||' | sort)
        all=$(cd -- "$root/$runs" && find . -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
        pids=$(printf '%s\n' "$old" | sed -n 's/^.*-\([0-9][0-9]*\)$/\1/p')
        live=" "
        if [ -n "$pids" ]; then
            # shellcheck disable=SC2086
            live=" $(node -e 'for (const p of process.argv.slice(1)) { try { process.kill(Number(p), 0); console.log(p); } catch (e) { if (e.code === "EPERM") console.log(p); } }' $pids | tr '\n' ' ')"
        fi
        n_old=0
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            n_old=$((n_old + 1))
            pid=$(printf '%s\n' "$name" | sed -n 's/^.*-\([0-9][0-9]*\)$/\1/p')
            if ! is_name "$name" || [ -z "$pid" ]; then
                printf 'не трогаю: %s/%s — имя не в форме <время>-<pid>\n' "$runs" "$name"
                continue
            fi
            case "$live" in
                *" $pid "*)
                    printf 'идёт: %s/%s — pid %s жив\n' "$runs" "$name" "$pid"
                    runs_live=$((runs_live + 1))
                    continue
                    ;;
            esac
            remove_tree "$runs/$name"
            runs_gone=$((runs_gone + 1))
        done <<EOF
$old
EOF
        runs_fresh=$((all - n_old))
    fi
    if [ -n "$(ls "$root/$cache/parallel-tests"/*.junit.xml 2>/dev/null)" ]; then
        printf 'не трогаю: %s/parallel-tests/*.junit.xml — длительности тестов для раскладки\n' "$cache"
    fi

    state="$cache/screenshots-reminder"
    state_gone=0
    if [ -d "$root/$state" ]; then
        old=$(cd -- "$root/$state" && find . -mindepth 1 -maxdepth 1 -type d -mmin "+$((days * 1440))" | sed 's|^\./||' | sort)
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            if ! is_name "$name"; then
                printf 'не трогаю: %s/%s — имя не похоже на идентификатор сессии\n' "$state" "$name"
                continue
            fi
            remove_tree "$state/$name"
            state_gone=$((state_gone + 1))
        done <<EOF
$old
EOF
    fi

    # Корень кеша: своё состояние барьеров и команд — не мусор, чужое — не моё.
    kept=""
    foreign=""
    for e in "$root/$cache"/* "$root/$cache"/.[!.]*; do
        [ -e "$e" ] || [ -L "$e" ] || continue
        n=$(basename -- "$e")
        case "$n" in
            mutants|parallel-tests|screenshots-reminder) ;;
            comment-guard|push-lost|user-files-window|task-start|tracker) kept="$kept $n" ;;
            *) foreign="$foreign $n" ;;
        esac
    done
    [ -z "$kept" ] || printf 'не трогаю: состояние барьеров и команд —%s\n' "$kept"
    [ -z "$foreign" ] || printf 'не моё, не трогаю:%s\n' "$foreign"

    printf 'итог: копий мутантов %s %s (заняты прогоном: %s), прогонов тестов %s %s (идут: %s, моложе %s дн.: %s), каталогов состояния %s %s\n' \
        "$verb" "$mut_gone" "$mut_busy" "$verb" "$runs_gone" "$runs_live" "$days" "$runs_fresh" "$verb" "$state_gone"
    cache_status=$status
fi

[ "$apply" = "1" ] || printf '\nсухой прогон. Удалить на самом деле — тот же вызов с --apply\n'
[ "$cache_status" = "0" ] || exit "$cache_status"
