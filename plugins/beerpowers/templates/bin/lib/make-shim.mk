# make-shim.mk — подмешивается скриптом .claude/bin/make-shim к Makefile репозитория.
# generated by beerpowers v{{BEERPOWERS_VERSION}} — не править: обновляет /beerpowers:update
#
# Самостоятельного смысла не имеет, руками не вызывается.
#
# Единственная задача — протолкнуть TMP и TEMP в окружение рецепта на Windows.
# Значения задаёт скрипт при вызове (TMP=... TEMP=...), здесь только export:
# машинных путей в файле нет, поэтому он и лежит в репозитории.
#
# Почему это нужно: make под Windows берётся из MSYS2, а он не пропускает TMP
# и TEMP в рецепт — внутри они пусты. PHP при этом нативной сборки, и без них
# sys_get_temp_dir() отдаёт C:\WINDOWS. Писать туда нельзя, инструменты падают:
#   Rector  — Unable to create directory 'C:\WINDOWS\cache' with mode 777
#   PHPStan — Failed creating temp file for stdout
#
# Почему через -f, а не переменной MAKEFILES: файл в MAKEFILES читается
# (проверено через $(info)), но export из него до рецепта не доходит.

export TMP
export TEMP
