#!/usr/bin/env bash
# generated by beerpowers v{{BEERPOWERS_VERSION}} — не править: обновляет /beerpowers:update
#
# make-shim — прослойка над make, снимающая особенности платформы.
#
# Вызывается ровно как make, все аргументы уходят дальше без разбора:
#
#     .claude/bin/make-shim -C <путь-репо> check
#     .claude/bin/make-shim -C <путь-репо> phpstan
#
# На Linux и macOS не делает НИЧЕГО — это чистый проброс в системный make.
# Вся его работа существует только на Windows, где голый make не годится
# по двум независимым причинам.
#
# 1. Оболочка. `make` из PATH — сборка ezwinports (Built for Windows32).
#    Она не разрешает `/bin/bash` из первой строки Makefile и молча уходит
#    в cmd, а cmd читает прямые слэши как признак ключа и спотыкается:
#    «"vendor-bin" не является внутренней или внешней командой».
#    Не лечится ни `make SHELL=…` (игнорируется), ни `MAKESHELL`
#    (игнорируется этой сборкой), ни `.ONESHELL`. Берётся make из MSYS2.
#
# 2. Временный каталог. MSYS2-make не пропускает TMP и TEMP в рецепт —
#    внутри они пусты. PHP тут нативный, и без них sys_get_temp_dir()
#    отдаёт C:\WINDOWS; Rector и PHPStan падают на попытке туда писать.
#    Значения передаются make-переменными, а `lib/make-shim.mk` рядом со скриптом
#    выталкивает их в окружение рецепта через export.
#
# Подмешивание идёт флагом `-f`, а не переменной MAKEFILES: файл в MAKEFILES
# читается, но export из него до рецепта не доходит. Раз передан хоть один
# `-f`, make перестаёт сам подхватывать Makefile каталога, поэтому он назван
# явно — относительным именем, потому что `-C` применяется раньше чтения
# makefile'ов и путь разрешится уже внутри репозитория.

set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
shim_mk="$self_dir/lib/make-shim.mk"

usage() {
    awk 'NR > 3 && !/^#/ { exit } NR > 3 { sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
}

case "${1:-}" in
    ''|-h|--help)
        usage
        exit 0
        ;;
esac

# Не Windows — добавлять нечего, платформа ведёт себя правильно сама
case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*) ;;
    *)
        exec make "$@"
        ;;
esac

make_bin=/c/msys64/usr/bin/make.exe

if [ ! -x "$make_bin" ]; then
    cat >&2 <<'HINT'
make-shim: не найден make из MSYS2 (C:\msys64\usr\bin\make.exe).

Тот make, что лежит в PATH, под Windows не работает: он не разрешает
/bin/bash из Makefile и уходит в cmd, где рецепты вида vendor-bin/... падают.

Поставить:
    winget install --id MSYS2.MSYS2 --accept-package-agreements --accept-source-agreements
    C:\msys64\usr\bin\pacman.exe -S --noconfirm make
HINT
    exit 1
fi

if [ ! -f "$shim_mk" ]; then
    echo "make-shim: рядом нет lib/make-shim.mk (ожидался $shim_mk)" >&2
    exit 1
fi

# Нативному PHP нужен временный каталог в виде windows-пути. Git Bash отдаёт
# его с обратными слэшами, cygpath приводит к форме, которую понимают обе стороны.
tmp_dir=${TMP:-${TEMP:-${LOCALAPPDATA:-}/Temp}}

if [ -z "$tmp_dir" ]; then
    echo "make-shim: не удалось определить временный каталог (пусты TMP, TEMP и LOCALAPPDATA)" >&2
    exit 1
fi

tmp_dir=$(cygpath -m "$tmp_dir")

exec "$make_bin" -f Makefile -f "$(cygpath -m "$shim_mk")" TMP="$tmp_dir" TEMP="$tmp_dir" "$@"
