{
  "beerpowers": "2.0.1",
  "ui": true,
  "viewports": [
    { "name": "mobile", "width": 375, "height": 667, "mobile": true },
    { "name": "tablet", "width": 768, "height": 1024, "mobile": true },
    { "name": "desktop", "width": 1280, "height": 720 }
  ],
  "barriers": {
    "guard-push": true,
    "guard-kill": true,
    "guard-comments": true,
    "guard-commit-split": true
  },
  "comments": {
    "excludeDirs": ["projects/shop-frontend/app/api"]
  },
  "tests": {
    "repos": {
      "shop-backend": {
        "command": "php vendor/bin/phpunit -c phpunit.xml --colors=never --no-coverage --log-junit \"{junit}\" {files}",
        "files": ["tests/Unit/**/*Test.php", "tests/Feature/**/*Test.php"],
        "env": {
          "DB_DATABASE": "shop_w{i}_test",
          "TEST_TOKEN": "{i}",
          "TMP": "{tmp}",
          "TEMP": "{tmp}",
          "TMPDIR": "{tmp}"
        },
        "prepare": "sh \"{root}/.claude/bin/testdb-ensure\"",
        "mutate": {
          "command": "php vendor/bin/phpunit -c phpunit.xml --no-coverage --colors=never --stop-on-failure {filter}",
          "check": "php -l \"{file}\"",
          "link": ["vendor"],
          "copy": [".env.testing"]
        }
      }
    }
  }
}
